# ---------------------------------------------------------------------------
# Ticktz configuration. Copy to `.env` and adjust. Never commit your .env.
# ---------------------------------------------------------------------------

APP_NAME=Ticktz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Amsterdam
APP_URL=http://localhost:8080

# Default UI language for users who have not picked one (supported: en, nl).
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ticktz
DB_USERNAME=ticktz
DB_PASSWORD=secret
# Only used by the bundled MySQL container.
DB_ROOT_PASSWORD=root-secret

# --- Redis (cache, queue, sessions) ----------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
CACHE_PREFIX=ticktz
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Outgoing mail (SMTP) ---------------------------------------------------
# The default points at the GreenMail container in the development stack; read
# its web interface on http://localhost:8025. A mailbox configured in
# Settings -> Mailboxes overrides this per address.
MAIL_MAILER=smtp
MAIL_HOST=mail
MAIL_PORT=3025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="servicedesk@example.org"
MAIL_FROM_NAME="${APP_NAME}"

# --- LDAP / Active Directory ------------------------------------------------
# Leave LDAP_ENABLED=false to run with local accounts only. Per-directory
# settings can also be managed from the admin UI (Settings -> Directories).
LDAP_ENABLED=false
LDAP_CONNECTION=default
LDAP_HOST=ldap.example.org
LDAP_PORT=389
LDAP_BASE_DN="dc=example,dc=org"
LDAP_USERNAME="cn=ticktz,ou=service,dc=example,dc=org"
LDAP_PASSWORD=
LDAP_SSL=false
LDAP_TLS=false
LDAP_TIMEOUT=5
LDAP_LOGGING=false
LDAP_CACHE=false

# --- Docker compose knobs ---------------------------------------------------
TICKTZ_HTTP_PORT=8080
TICKTZ_VITE_PORT=5173
TICKTZ_MYSQL_PORT=3306
TICKTZ_MAIL_SMTP_PORT=3025
TICKTZ_MAIL_IMAP_PORT=3143
TICKTZ_MAIL_UI_PORT=8025
TICKTZ_QUEUES=high,default,mail,webhooks,low
TICKTZ_QUEUE_WORKERS=2
# Run `php artisan migrate` automatically when the app container boots.
TICKTZ_AUTO_MIGRATE=true

# --- Ticktz application settings -------------------------------------------
# Maximum attachment size in kilobytes and the allowed extensions.
TICKTZ_MAX_ATTACHMENT_KB=25600
TICKTZ_ALLOWED_ATTACHMENT_EXTENSIONS="pdf,png,jpg,jpeg,gif,webp,txt,csv,log,doc,docx,xls,xlsx,ppt,pptx,odt,ods,zip,eml,msg"
# Rate limits (requests per minute).
TICKTZ_LOGIN_RATE_LIMIT=5
TICKTZ_PORTAL_RATE_LIMIT=60
TICKTZ_API_RATE_LIMIT=120

VITE_APP_NAME="${APP_NAME}"
